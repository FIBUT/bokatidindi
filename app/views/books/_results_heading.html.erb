<div class="row">
  <div class="col-12 pb-2">
    <h1 id="results-heading">
      <% unless params[:publisher] || params[:category] || params[:author] || params[:search] %>
        Allar bækur
      <% end %>
      <% unless params[:author].nil? %>
        Höfundur: <%= @author.name %>
      <% end %>
      <% unless params[:publisher].nil? %>
        Útgefandi: <%= @publisher.name %>
      <% end %>
      <% unless params[:category].nil? %>
        <%= @nav_title %>
      <% end %>
      <% unless params[:search].nil? %>
        Leitarorð: <%= params[:search] %>
      <% end %>
    </h1>
  </div>
  <div class="col-12 col-lg-6 pb-2">
    <% if (! params[:search] ) %>
      <% if params[:category] && @category %>
        <p class="category-description"><%= @category.description %></p>
      <% end %>
      <% if @books.total_pages > 1 %>
        <p class="page-counter">Síða <%= @books.current_page %> af <%= @books.total_pages %></p>
      <% end %>
    <% end %>
  </div>
  <% if @available_tags %>
  <nav class="col pb-2 justify-content-md-end">
    <ul class="nav nav-pills justify-content-md-end">
      <% if @home_path %>
        <li class="nav-item">
         <% if params[:tag_slug] %>
          <%= link_to 'Allar', @home_path, class: "nav-link" %>
          <% else %>
          <%= link_to 'Allar', @home_path, class: 'nav-link active' %>
          <% end %>
        </li>
      <% end %>
      <% @available_tags.each do |t| %>
        <li class="nav-item">
          <% if t.slug == params[:tag_slug]  %>
          <%= link_to t.title_plural, t.path(@category), class: "nav-link active" %>
          <% else %>
          <%= link_to t.title_plural, t.path(@category), class: 'nav-link' %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>
  <% end %>
</div>